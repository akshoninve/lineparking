# Файлы в этой папке не предназначены для прямого открытия в браузере —
# они только подключаются (require) из index.php и oferta.php через bootstrap.php.
# Этот .htaccess — дополнительный слой защиты (defense in depth) на случай,
# если кто-то попробует открыть, например, /includes/parkings-data.php напрямую.
#
# Работает на Apache с включённым mod_authz_core / mod_access_compat.
# Если сайт на Nginx — .htaccess игнорируется, тогда попросите хостера/
# администратора добавить в конфиг сайта аналогичный блок:
#   location /includes/ { deny all; }

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
