# .htaccess (корень public_html)
# Сжатие и кэширование статики — см. рекомендации PageSpeed Insights
# от 31.07.2026: "Без сжатия" (~10 KiB) и "Время жизни кеша: None"
# для style.css / main.js (~21 KiB суммарно).
#
# Не конфликтует с includes/.htaccess (там отдельное правило —
# запрет прямого доступа к файлам в includes/).

# ---------- Сжатие (gzip) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml
  AddOutputFilterByType DEFLATE text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Кэширование статики в браузере ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType image/jpeg              "access plus 1 month"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

# Резервный вариант, если mod_expires недоступен на хостинге —
# Cache-Control через mod_headers (обычно есть почти везде).
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpe?g|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
